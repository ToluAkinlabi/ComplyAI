# Core AI settings
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Auth and tenancy
JWT_SECRET=replace_with_a_strong_secret
DEFAULT_ADMIN_EMAIL=admin@complyai.io
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('change-me'))"
DEFAULT_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
DEFAULT_ORG_NAME=ComplyAI
DEFAULT_ORG_SLUG=complyai
USE_DB_AUTH=true
REQUIRE_AUTH=true
MONTHLY_REPORT_LIMIT_PER_ORG=0

# Database
# Local sqlite fallback:
# DATABASE_URL=sqlite:///./complyai.db
# Supabase transaction pooler/session pooler URL:
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DB_SSLMODE=require
AUTO_INIT_DB=true
STRICT_MIGRATIONS=false
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional Supabase Storage artifact mirroring
ENABLE_SUPABASE_STORAGE=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=reports

# Semantic retrieval + reranker
SEMANTIC_MODEL=all-mpnet-base-v2
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_MULTIPLIER=4
RERANKER_TOP_N=20

# Classification tuning
ALIGNED_THRESHOLD=0.7
WEAK_THRESHOLD=0.4
MIN_CONFIDENCE_MARGIN=0.05
KEYWORD_OVERLAP_ALIGNED=0.35
KEYWORD_OVERLAP_WEAK=0.2
